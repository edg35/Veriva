# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/veriva_db

# Clerk — from https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_test_...

# Clerk JWKS URL for JWT verification: API Keys → Advanced → JWT public key → JWKS URL
# Format: https://<your-frontend-api-host>/.well-known/jwks.json
CLERK_JWKS_URL=https://xxx.clerk.accounts.dev/.well-known/jwks.json

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Verification request expiry (days)
REQUEST_EXPIRY_DAYS=7
